{
    "default_provider": "gemini",
    "providers": {
        "gemini": {
            "type": "gemini",
            "api_key": "YOUR_GEMINI_API_KEY"
        }
    },
    "transcriber": {
        "provider": "groq",
        "api_key": "YOUR_GROQ_API_KEY"
    },
    "synthesizer": {
        "provider": "gemini",
        "api_key": "YOUR_GEMINI_API_KEY"
    },
    "heartbeat": {
        "active": true,
        "every": "30m",
        "to": "123456789",
        "channel": "telegram"
    },
    "bot": {
        "owner_ids": [
            "YOUR_OWNER_ID_1"
        ],
        "type": "private",
        "watermark": false,
        "stream": true,
        "max_iterations": 100,
        "warning_iterations": 90,
        "context_max_tokens": 64000,
        "max_tool_output_bytes": 32768,
        "repeat_tool_call_limit": 3,
        "tool_timeout_seconds": 300,
        "run_timeout_seconds": 900,
        "stream_timeout_seconds": 180,
        "request_retries": 1,
        "blocked_tools": []
    },
    "channels": {
        "telegram": {
            "active": true,
            "token": "YOUR_TELEGRAM_BOT_TOKEN",
            "mode": "polling",
            "ngrok_active": false,
            "ngrok_auth_token": ""
        },
        "discord": {
            "active": false,
            "token": "YOUR_DISCORD_BOT_TOKEN"
        }
    },
    "cron": {
        "active": true
    }
}