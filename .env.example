# API
PORT=8080
HOST=http://localhost
MYAAW_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:5050,http://localhost:8080

# DATABASE
# DB_PATH= (Optional, defaults to ~/.myaaw/myaaw.db)

# EXTERNAL SKILLS / TOOLS
TAVILY_API_KEY=

# EXTERNAL VOICE (transcription / speech synthesis)
TRANSCRIBER_PROVIDER_NAME=
TRANSCRIBER_API_KEY=
SYNTHESIZER_PROVIDER_NAME=
SYNTHESIZER_API_KEY=

# AGENT / LLM TUNING
# Context transcript before compaction. 0 disables compaction.
AGENT_CONTEXT_MAX_TOKENS=64000
# Tool output is truncated to this size before entering the transcript.
AGENT_MAX_TOOL_OUTPUT_BYTES=32768
# Maximum tool-call iterations per run. 0 disables the cap.
AGENT_MAX_ITERATIONS=100
# Warn after this many iterations (must stay below AGENT_MAX_ITERATIONS).
AGENT_WARNING_ITERATIONS=90
# Warn after the same tool + arguments are called this many times. 0 disables.
AGENT_REPEAT_TOOL_CALL_LIMIT=3
# Timeout per tool execution in seconds. 0 disables the outer tool timeout.
AGENT_TOOL_TIMEOUT_SECONDS=300
# Comma-separated tool names to block, e.g. bash,python
AGENT_BLOCKED_TOOLS=
# Extra retries after the initial provider request (1 = up to 2 attempts).
LLM_REQUEST_RETRIES=1
# Inbound chat messages processed concurrently. Messages from the same user stay in order.
QUEUE_WORKERS=4
# Overall agent run deadline in seconds.
AGENT_RUN_TIMEOUT_SECONDS=900
# Timeout per provider request/stream in seconds.
LLM_STREAM_TIMEOUT_SECONDS=180
# Stream responses by default. config.json "bot.stream" takes priority over this.
STREAM_RESPONSE=true

# Bearer token for incoming A2A requests. Empty disables auth (local only).
A2A_TOKEN=
# Optional comma-separated per-caller A2A tokens (shared "default" identity).
A2A_TOKENS=
# Named callers with scopes: name:token[:read|delegate], comma-separated.
# delegate implies read. Example: monitor:tok-1:read,research:tok-2:delegate
A2A_CALLERS=
# Ed25519 PKCS#8 PEM key used to sign the Agent Card (JWS, EdDSA).
# Generate with: openssl genpkey -algorithm ED25519 -out ~/.myaaw/<agent>/a2a_key.pem
A2A_SIGNING_KEY=
# Trusted peer keys: name:base64url-ed25519-public-key, comma-separated.
A2A_TRUSTED_KEYS=

# Optional Agent Card metadata.
A2A_PROVIDER_URL=
A2A_PROVIDER_ORGANIZATION=
A2A_DOCUMENTATION_URL=
A2A_ICON_URL=
# Optional path to a JSON file merged over the public Agent Card.
A2A_EXTENDED_CARD=

# Allow webhook URLs pointing at loopback/private addresses (local testing only).
A2A_ALLOW_PRIVATE_WEBHOOKS=false
# Optional per-caller rate limit (requests/second) and burst.
A2A_RATE_LIMIT=
A2A_RATE_BURST=

# Optional gRPC binding. Set A2A_GRPC_PORT to enable it.
A2A_GRPC_PORT=
# A2A_GRPC_ADDR=
# A2A_GRPC_TLS_CERT=
# A2A_GRPC_TLS_KEY=

# Server-wide HTTP request body limit (bytes). Sized for inline file parts.
# A2A_MAX_REQUEST_BYTES=16777216
# How long the contact tool waits for a remote task. Keep it above the remote
# agent's run timeout so retries do not duplicate work.
# A2A_CONTACT_TIMEOUT_SECONDS=960

# OBSERVABILITY
# Record one trace per run in database/observability.db. Disable to opt out.
OBS_ENABLED=true
# Delete traces older than this many days. 0 keeps everything.
OBS_RETENTION_DAYS=30
# Cap for every stored prompt, thinking block, response, and tool payload.
OBS_MAX_CONTENT_CHARS=16384
# Store content at all. Set false to keep only metadata and token counts.
OBS_STORE_CONTENT=true
# Semicolon-separated regular expressions masked as [redacted]. Empty uses the built-in patterns.
OBS_REDACT_PATTERNS=
