# API
PORT=8080
HOST=http://localhost
MYAAW_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:5050,http://localhost:8080

# DATABASE
# DB_PATH= (Optional, defaults to ~/.myaaw/myaaw.db)

# EXTERNAL SKILLS / TOOLS
TAVILY_API_KEY=

# AGENT / LLM TUNING
# Context transcript before compaction. 0 disables compaction.
AGENT_CONTEXT_MAX_TOKENS=64000
# Tool output is truncated to this size before entering the transcript.
AGENT_MAX_TOOL_OUTPUT_BYTES=32768
# Warn after the same tool + arguments are called this many times. 0 disables.
AGENT_REPEAT_TOOL_CALL_LIMIT=3
# Timeout per tool execution in seconds. 0 disables the outer tool timeout.
AGENT_TOOL_TIMEOUT_SECONDS=300
# Comma-separated tool names to block, e.g. bash,python
AGENT_BLOCKED_TOOLS=
# Extra retries after the initial provider request (1 = up to 2 attempts).
LLM_REQUEST_RETRIES=1
# Overall agent run deadline in seconds.
AGENT_RUN_TIMEOUT_SECONDS=900
# Timeout per provider request/stream in seconds.
LLM_STREAM_TIMEOUT_SECONDS=180
